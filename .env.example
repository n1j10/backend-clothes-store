NODE_ENV=development
PORT=5000

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/furniture_store"

# JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:5000

# Vercel Blob token (required on Vercel for image uploads; create a Blob store in the dashboard)
BLOB_READ_WRITE_TOKEN=

# Allowed frontend origins for CORS (comma-separated). Empty = allow all.
CORS_ORIGIN=
