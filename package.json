{
  "name": "furniture-store-api",
  "version": "1.0.0",
  "description": "Express REST API for the furniture store (ported from Next.js server actions)",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test":"node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "prisma": "6.1.0",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}
